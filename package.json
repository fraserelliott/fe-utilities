{
  "name": "@fraserelliott/fe-utilities",
  "version": "0.4.0",
  "description": "Bootstrap-style CSS utilities prefixed with fe- with inline style utilities, plus optional class presets and composition functions.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "css",
    "utilities",
    "utility-classes",
    "frontend"
  ],
  "files": [
  "dist/",
  "src/",
  "README.md",
  "LICENSE"
  ],
  "sideEffects":  ["**/*.css"],
  "exports": {
    "./fe-utilities.css": "./dist/fe-utilities.css",
    ".": "./src/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fraserelliott/fe-utilities"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "postcss": "^8.5.29",
    "postcss-js": "^5.1.0"
  },
  "scripts": {
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "build:css" : "node scripts/build-css.js",
    "prepack" : "npm run build:css"
  },
  "allowScripts": {
    "unrs-resolver@1.11.1": true
  }
}
